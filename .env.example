# Copia questo file in .env e compila i valori. Il file .env non va MAI su GitHub.

# --- Applicazione ---
APP_ENV=development
BUSINESS_NAME=NCC Levante Transfer
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Demo/sviluppo rapido: SQLite. Con Docker Compose: PostgreSQL (vedi docker-compose.yml)
DATABASE_URL=sqlite:///./data/app.db
AUTO_CREATE_SCHEMA=true

# --- Coda ---
# memory = un solo processo (demo); rabbitmq = API e worker separati (Fase 2)
QUEUE_BACKEND=memory
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2

# --- RAG ---
# extractive = risponde con le frasi dei documenti (gratis, nessun LLM)
# ollama     = LLM locale (es. llama3.2)   |   openai = API compatibile OpenAI
ANSWER_GENERATOR=extractive
RAG_EMBEDDER=tfidf
RAG_STORE=numpy
RAG_TOP_K=4
RAG_MIN_SCORE=
RAG_INDEX_DIR=data/index
DOCS_DIR=data/docs
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Privacy ---
RETENTION_DAYS=30

# --- Fase 2/3 (non ancora usate) ---
# SECRET_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# CONTACT_HASH_KEY=
# WHATSAPP_ENABLED=false
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v21.0
