# Copia questo file in .env e compila i valori. Il file .env non va MAI su GitHub.

# --- Applicazione ---
APP_ENV=development
BUSINESS_NAME=NCC Levante Transfer
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
# Demo/sviluppo rapido: SQLite. Con Docker Compose: PostgreSQL (vedi docker-compose.yml)
DATABASE_URL=sqlite:///./data/app.db
AUTO_CREATE_SCHEMA=true

# --- Coda ---
# memory = un solo processo (demo); rabbitmq = API e worker separati
QUEUE_BACKEND=memory
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=2

# --- RAG ---
# extractive = risponde con le frasi dei documenti (gratis, nessun LLM)
# ollama     = LLM locale (es. llama3.2)   |   openai = API compatibile OpenAI
ANSWER_GENERATOR=extractive
RAG_EMBEDDER=tfidf
RAG_STORE=numpy
RAG_TOP_K=4
RAG_MIN_SCORE=
RAG_INDEX_DIR=data/index
DOCS_DIR=data/docs
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# --- Privacy ---
# Conversazioni eliminate dopo N giorni dall'ultimo messaggio (controllo ogni 24 ore)
RETENTION_DAYS=30

# --- Limiti della chat web per IP ---
CHAT_MESSAGES_PER_MINUTE=10
CHAT_MESSAGES_PER_DAY=100
CHAT_CONVERSATIONS_PER_HOUR=30
# Chiave per l'HMAC dei numeri di telefono: stringa casuale lunga, es.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CONTACT_HASH_KEY=

# --- WhatsApp Cloud API (Meta for Developers → la tua app → WhatsApp → Configurazione API) ---
WHATSAPP_ENABLED=false
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App Secret: Impostazioni dell'app → Di base
META_APP_SECRET=
# Token scelto da te, da inserire anche nella configurazione del webhook su Meta
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0

# --- Worker (solo con QUEUE_BACKEND=rabbitmq) ---
WORKER_PREFETCH=4

# --- Area admin ---
# Chiave di firma delle sessioni: stringa casuale di almeno 32 caratteri
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Admin creato al primo avvio (password di almeno 12 caratteri)
ADMIN_EMAIL=
ADMIN_PASSWORD=
